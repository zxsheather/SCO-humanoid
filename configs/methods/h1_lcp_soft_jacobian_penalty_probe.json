{
  "name": "h1_lcp_soft_jacobian_penalty_probe",
  "method": {
    "id": "h1_lcp_soft_jacobian_penalty",
    "label": "H1 LCP-style soft Jacobian penalty (lambda_gp=0.002)",
    "family": "sota_adjacent_baseline",
    "smoothness_strategy": "fixed_soft_grad_log_prob_penalty"
  },
  "task": "h1_ppo",
  "experiment_name": "ecolab_h1_lcp_soft_penalty",
  "run_name": "h1_lcp_soft_jacobian_penalty_probe",
  "artifacts_root": "artifacts/methods/h1_lcp_soft_jacobian_penalty_probe",
  "evaluation_protocol": "h1_task_config_tuning",
  "upstream": {
    "repo_url": "https://github.com/roboterax/humanoid-gym",
    "ref": "ae46e201c85a2b17e7f2cea59a441dae7ea88a8f",
    "checkout_dir": ".external/humanoid-gym"
  },
  "training": {
    "headless": true,
    "num_envs": 512,
    "rl_device": "cuda:0",
    "sim_device": "cuda:0"
  },
  "evaluation": {
    "headless": true,
    "num_envs": 16,
    "episodes": 20,
    "rl_device": "cuda:0",
    "sim_device": "cuda:0",
    "seed": 100100,
    "metric_schema_version": 2,
    "constraint_logging": {
      "collect_local_sensitivity": true,
      "local_sensitivity_threshold": 3.8,
      "sample_envs": 4,
      "sample_every_n_steps": 20,
      "sidecar_metrics_filename": "constraint_metrics.json",
      "multiplier_trace_filename": "lcp_penalty_trace.json"
    }
  },
  "tuning_rationale": {
    "issue": "#103",
    "baseline_reference": "#110 repaired the H1 vanilla baseline gate and selected checkpoint 250 with fall_rate=0.000.",
    "changes": [
      "Keep the repaired H1 task/control overrides from #110 so the method probe stays on the stabilized H1 task floor.",
      "Disable the inherited action_smoothness, dof_acc, base_acc, and dof_vel reward terms so the soft Jacobian penalty is the only added smoothness mechanism.",
      "Reuse the main-method LCP-style settings with LCPPPO, lambda_gp=0.002, random subsample_obs=64, and epsilon=1e-12."
    ],
    "claim_boundary": "Single-seed H1 method probe only; not cross-morphology claim-grade evidence."
  },
  "overrides": {
    "env": {
      "commands.heading_command": false,
      "domain_rand.randomize_friction": false,
      "domain_rand.randomize_base_mass": false,
      "domain_rand.push_robots": false,
      "domain_rand.action_delay": 0.0,
      "domain_rand.action_noise": 0.0,
      "control.decimation": 20,
      "rewards.base_height_target": 1.05,
      "rewards.cycle_time": 0.8,
      "rewards.target_feet_height": 0.08,
      "rewards.scales.action_smoothness": 0.0,
      "rewards.scales.dof_acc": 0.0,
      "rewards.scales.base_acc": 0.0,
      "rewards.scales.dof_vel": 0.0
    },
    "train": {
      "runner.algorithm_class_name": "LCPPPO",
      "runner.max_iterations": 300,
      "runner.save_interval": 50,
      "algorithm.lcp.enabled": true,
      "algorithm.lcp.lcp_weight": 0.002,
      "algorithm.lcp.subsample_obs": 64,
      "algorithm.lcp.epsilon": 1e-12,
      "algorithm.lcp.local_sensitivity_threshold": 3.8
    }
  }
}
