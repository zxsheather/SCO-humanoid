  },
  "training": {
    "headless": true,
    "num_envs": 512,
    "rl_device": "cuda:0",
    "sim_device": "cuda:0"
  },
  "evaluation": {
    "headless": true,
    "num_envs": 16,
    "episodes": 20,
    "rl_device": "cuda:0",
    "sim_device": "cuda:0",
    "seed": 100100,
    "metric_schema_version": 2,
    "constraint_logging": {
      "collect_local_sensitivity": true,
      "local_sensitivity_threshold": null,
      "sample_envs": 4,
      "sample_every_n_steps": 20,
