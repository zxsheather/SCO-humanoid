  "tuning_rationale": {
    "issue": "#109",
    "baseline_failure": "#108 kept fall_rate at 0.300-0.350 after 400 iterations.",
    "changes": [
      "Disable heading_command so yaw commands use H1Cfg.commands.ranges.ang_vel_yaw=[-0.3, 0.3] instead of the inherited heading controller clipping to [-1, 1].",
      "Disable inherited XBot-L domain randomization and action-delay/noise disturbances for the first H1 task-validity gate."
    ],
    "claim_boundary": "Task/config stabilization only; not a smooth-control method."
  },
  "overrides": {
    "env": {
      "commands.heading_command": false,
      "domain_rand.randomize_friction": false,
      "domain_rand.randomize_base_mass": false,
      "domain_rand.push_robots": false,
      "domain_rand.action_delay": 0.0,
      "domain_rand.action_noise": 0.0
    },
    "train": {
      "runner.max_iterations": 300,
      "runner.save_interval": 50
    }
  }
